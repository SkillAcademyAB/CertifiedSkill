@page "/participant/login/sent"

<PageTitle>Länk skickad – Deltagare</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5 text-center">
        <div class="mb-4">
            <span class="bi bi-envelope-check" style="font-size: 3rem;" aria-hidden="true"></span>
        </div>
        <h1>Kontrollera din e-post</h1>
        <p>
            Om e-postadressen är kopplad till ett konto har vi skickat en inloggningslänk.
            Länken är giltig i 15 minuter och kan endast användas en gång.
        </p>
        <p class="text-muted small">
            Fick du ingen e-post? Kontrollera skräppostmappen eller
            <a href="/participant/login">försök igen</a>.
        </p>
    </div>
</div>
